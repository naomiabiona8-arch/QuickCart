{
  "compilerOptions": {
    "target": "es2022", //javasript/typescript version
    "module": "nodenext", // tells typrscript how to handle imports and exports of packages
    "moduleResolution": "nodenext",
    "rootDir": "src",  // tells typescript that all your sourcefiles lives inside src
    "outDir": "dist", // dist simply means distribution
    "types": ["node"], //typescript works with node modules
    "strict": true,  // turns on all checks e.g synthax errors etc
    "esModuleInterop": true, // it lets us imports packages
    "skipLibCheck": true, // check for spelling errors
    "forceConsistentCasingInFileNames": true  //prevents bugs caused by case-sensitive files
  },
  "include": ["src"]  //tells typescript which file to include in the compilation
}
